// Advanced features: function literals, static, sizeof

// Static constants
static PI: float := 3.14159
static MAX_BUFFER_SIZE: int := 1024
static DEBUG: bool := true

// Static with generics
static default_value[T]: T where T: i32 | float | bool := 
    match type T {
        i32: { 0 },
        float: { 0.0 },
        bool: { false }
    }

// Function type aliases
comparator[T]: type := (a: T, b: T) bool
processor[T]: type := (item: T) T

// Higher-order function
map[T, U]: (arr: [5 T], f: (T) U) [5 U] {
    mut result: [5 U] := {}
    for i: int := 0; i < 5; i += 1 {
        result[i] = f(arr[i])
    }
    return result
}

// Function that returns a function
make_adder: (n: i32) (i32) i32 {
    // Function literal capturing n
    return |x: i32| i32 { return x + n }
}

// Function taking function parameter
apply_twice[T]: (x: T, f: (T) T) T {
    return f(f(x))
}

main: () i32 {
    // Using static constants
    radius: float := 5.0
    area: float := PI * radius * radius
    
    // Sizeof operator
    int_size: int := sizeof(i32)           // 4
    ptr_size: int := sizeof(ptr[i32])      // Platform dependent
    struct_size: int := sizeof(struct { x: i32, y: i32 })  // 8
    array_size: int := sizeof([10 i32])    // 40
    
    // Sizeof with type expression
    complex_size: int := sizeof(struct {
        data: [100 u8],
        count: int,
        flags: u32
    })
    
    // Function literals
    add_one: (i32) i32 := |x: i32| i32 { return x + 1 }
    double: (i32) i32 := |x: i32| i32 { return x * 2 }
    
    // Using function literals
    result1: i32 := add_one(5)  // 6
    result2: i32 := double(10)   // 20
    
    // Function literal with multiple parameters
    multiply: (i32, i32) i32 := |a: i32, b: i32| i32 { return a * b }
    result3: i32 := multiply(3, 4)  // 12
    
    // Function literal as comparator
    less_than: comparator[i32] := |a: i32, b: i32| bool { return a < b }
    greater_than: comparator[i32] := |a: i32, b: i32| bool { return a > b }
    
    // Using higher-order functions
    numbers: [5 i32] := {1, 2, 3, 4, 5}
    squared: [5 i32] := map[i32, i32](numbers, |n: i32| i32 { return n * n })
    
    // Function returning function
    add5: (i32) i32 := make_adder(5)
    add10: (i32) i32 := make_adder(10)
    
    val1: i32 := add5(3)   // 8
    val2: i32 := add10(3)  // 13
    
    // Apply function twice
    result4: i32 := apply_twice[i32](3, double)  // 12 (3 * 2 * 2)
    
    // Complex function literal
    transform: (struct { x: i32, y: i32 }) struct { x: i32, y: i32 } := 
        |p: struct { x: i32, y: i32 }| struct { x: i32, y: i32 } {
            return { x: p.y, y: p.x }  // Swap coordinates
        }
    
    point: struct { x: i32, y: i32 } := { x: 10, y: 20 }
    swapped: struct { x: i32, y: i32 } := transform(point)
    
    // Conditional compilation using static
    mut debug_count: i32 := 0
    if DEBUG {
        debug_count += 1
    }
    
    // Array of function pointers
    operations: [3 (i32, i32) i32] := {
        |a: i32, b: i32| i32 { return a + b },
        |a: i32, b: i32| i32 { return a - b },
        |a: i32, b: i32| i32 { return a * b }
    }
    
    // Using array of functions
    op_result: i32 := operations[0](10, 5)  // 15 (addition)
    
    // Nested function literals
    compose: ((i32) i32, (i32) i32) (i32) i32 := 
        |f: (i32) i32, g: (i32) i32| (i32) i32 {
            return |x: i32| i32 { return f(g(x)) }
        }
    
    add_then_double: (i32) i32 := compose(double, add_one)
    final_result: i32 := add_then_double(5)  // 12 ((5 + 1) * 2)
    
    return 0
}